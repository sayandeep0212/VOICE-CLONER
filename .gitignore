# Environment & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.local
.env.*.local
*.env

# Dependencies
node_modules/
/.pnp
.pnp.js
venv/
.venv/
env/
ENV/

# Production & Build outputs
.next/
out/
build/
dist/
*.tsbuildinfo

# Python Cache & Artifacts
