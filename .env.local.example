# Smriti Environment Configuration

# Supabase (Auth, Postgres, pgvector, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Providers (Free Tiers)
GEMINI_API_KEY=
GROQ_API_KEY=

# Voice Providers
# ElevenLabs (Voice Cloning & Natural Multilingual TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Voice Server (XTTS-v2 on Colab / Local / Tunnel)
VOICE_SERVER_URL=http://localhost:8000
VOICE_SERVER_SECRET=smriti-dev-secret-2025

# Optional Redis Context Cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App Demo Mode Flag: When enabled, provides realistic local persona & simulation fallbacks
NEXT_PUBLIC_DEMO_MODE=true
